{
  "name": "dash_bucket_upload",
  "version": "0.1.0",
  "description": "Large-file upload component for Plotly Dash that stores files in an S3-compatible bucket",
  "main": "build/index.js",
  "scripts": {
    "validate-init": "uv run python _validate_init.py",
    "prepublishOnly": "npm run validate-init",
    "build:js": "webpack --mode production",
    "build:backends": "uv run dash-generate-components ./src/lib/components dash_bucket_upload -p package-info.json --ignore \"\\.test\\.\"",
    "build:py": "npm run build:backends",
    "build": "npm run build:js && npm run build:backends",
    "build:all": "npm run build:js && npm run build:backends",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Scott Lemke <scott.r.lemke@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.22.1",
    "@babel/eslint-parser": "^7.25.0",
    "@babel/preset-env": "^7.22.2",
    "@babel/preset-react": "^7.22.3",
    "@plotly/dash-component-plugins": "^1.2.3",
    "@plotly/webpack-dash-dynamic-import": "^1.2.0",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-docgen": "^5.4.3",
    "react-dom": "^18.2.0",
    "style-loader": "^4.0.0",
    "styled-jsx": "^5.1.0",
    "vitest": "^4.1.9",
    "webpack": "^5.84.1",
    "webpack-cli": "^7.0.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
